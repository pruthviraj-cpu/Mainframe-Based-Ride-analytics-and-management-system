//RUNRIDE  JOB 1,CLASS=A,MSGLEVEL=(1,1),NOTIFY=&SYSUID
//* -------------------------------------------------------------
//* STEP 1: CLEANUP PREVIOUS RUN OUTPUT FILES (IF ANY)
//* -------------------------------------------------------------
//CLEANUP  EXEC PGM=IEFBR14
//DD3      DD DSN=&SYSUID..RIDE.FILE3.LEDGER,
//            DISP=(MOD,DELETE),SPACE=(TRK,0)
//DD4      DD DSN=&SYSUID..RIDE.FILE4.FRAUD,
//            DISP=(MOD,DELETE),SPACE=(TRK,0)
//DD5      DD DSN=&SYSUID..RIDE.FILE5.SUMMARY,
//            DISP=(MOD,DELETE),SPACE=(TRK,0)
//* -------------------------------------------------------------
//* STEP 2: EXECUTE COBOL ANALYTICS & FRAUD ENGINE
//* -------------------------------------------------------------
//RUNCOB   EXEC PGM=RIDEANLZ
//STEPLIB  DD DSN=&SYSUID..LOAD,DISP=SHR
//TRIPDATA DD DSN=&SYSUID..RIDE.FILE1.SORTED,DISP=SHR
//DRVDATA  DD DSN=&SYSUID..RIDE.FILE2.SORTED,DISP=SHR
//LEDGER   DD DSN=&SYSUID..RIDE.FILE3.LEDGER,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(5,2)),VOL=SER=ZXPC02,
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//FRAUDRPT DD DSN=&SYSUID..RIDE.FILE4.FRAUD,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(5,2)),VOL=SER=ZXPC02,
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SUMRPT   DD DSN=&SYSUID..RIDE.FILE5.SUMMARY,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(5,2)),VOL=SER=ZXPC02,
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSOUT   DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//* -------------------------------------------------------------
//* STEP 3: AUTOMATICALLY LOAD MASTER LEDGER INTO VSAM KSDS
//* -------------------------------------------------------------
//LOADVSAM EXEC PGM=IDCAMS,COND=(0,NE)
//SYSPRINT DD SYSOUT=*
//INPS     DD DSN=&SYSUID..RIDE.FILE3.LEDGER,DISP=SHR
//SYSIN    DD *
  DELETE &SYSUID..RIDE.FILE3.VSAM CLUSTER PURGE
  SET MAXCC = 0
  DEFINE CLUSTER -
    (NAME(&SYSUID..RIDE.FILE3.VSAM) -
     INDEXED -
     KEYS(8 0) -
     RECORDSIZE(80 80) -
     TRACKS(5 2) -
     SHAREOPTIONS(2 3)) -
    DATA(NAME(&SYSUID..RIDE.FILE3.VSAM.DATA)) -
    INDEX(NAME(&SYSUID..RIDE.FILE3.VSAM.INDEX))
  IF LASTCC = 0 THEN -
    REPRO INFILE(INPS) -
          OUTDATASET(&SYSUID..RIDE.FILE3.VSAM)
/*
